# Base URL проекта в TFS / Azure DevOps
TFS_URL=https://dev.azure.com/organization/project

# Personal Access Token (приоритет над NTLM)
TFS_PAT=

# NTLM-аутентификация (если PAT не задан)
TFS_USERNAME=
TFS_PASSWORD=

# Версия REST API (по умолчанию 6.0)
TFS_API_VERSION=6.0

# Таймаут запросов в секундах
TFS_TIMEOUT=60

# SSL: путь к корпоративному CA или отключение проверки
# TFS_CA_BUNDLE=/path/to/corporate-ca.pem
# TFS_VERIFY_SSL=false
